<UserControl x:Class="WinOldRecovery.App.Controls.SmartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="What is this?" FontWeight="SemiBold" />
        <TextBlock Text="{Binding What}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="Why does it matter?" FontWeight="SemiBold" />
        <TextBlock Text="{Binding WhyItMatters}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="What is restored?" FontWeight="SemiBold" />
        <TextBlock Text="{Binding WhatIsRestored}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="Can the cloud restore it?" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CloudAlternative}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="Does it regenerate?" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Regeneratable}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="If I leave it behind?" FontWeight="SemiBold" />
        <TextBlock Text="{Binding IfLeftBehind}" TextWrapping="Wrap" />
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Components}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Title, Mode=OneWay}" />
                        <Run Text=" — " />
                        <Run Text="{Binding Summary, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
