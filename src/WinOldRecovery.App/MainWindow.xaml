<Window x:Class="WinOldRecovery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinOldRecovery.App.Controls"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="WinOld Recovery"
        AutomationProperties.AutomationId="WinOldRecoveryMain"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnWindowSizeChanged"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="WinOld Recovery" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding PromisesText}"
                           AutomationProperties.Name="Recovery promises" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Margin="0,0,8,0" Command="{Binding}" Tag="1" Click="OnStepClick" Content="1 Scan"
                            AutomationProperties.Name="Scan step" AutomationProperties.AutomationId="StepScan" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="→" />
                    <Button Margin="0,0,8,0" Tag="2" Click="OnStepClick" Content="2 Decide"
                            AutomationProperties.Name="Decide step" AutomationProperties.AutomationId="StepDecide" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="→" />
                    <Button Margin="0,0,8,0" Tag="3" Click="OnStepClick" Content="3 Preview"
                            AutomationProperties.Name="Preview step" AutomationProperties.AutomationId="StepPreview" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="→" />
                    <Button Margin="0,0,8,0" Tag="4" Click="OnStepClick" Content="4 Restore"
                            AutomationProperties.Name="Restore step" AutomationProperties.AutomationId="StepRestore" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="→" />
                    <Button Margin="0,0,8,0" Tag="5" Click="OnStepClick" Content="5 Verify"
                            AutomationProperties.Name="Verify step" AutomationProperties.AutomationId="StepVerify" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="→" />
                    <Button Tag="6" Click="OnStepClick" Content="6 Purge"
                            AutomationProperties.Name="Purge step" AutomationProperties.AutomationId="StepPurge" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SourceIntegrityText, StringFormat=● {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SpaceBudgetText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Log" Command="{Binding ShowLogCommand}" Margin="0,0,8,0"
                            AutomationProperties.Name="Open session log"
                            AutomationProperties.AutomationId="LogButton" />
                    <Button Content="Help" Command="{Binding OpenHelpCommand}"
                            AutomationProperties.Name="Open help"
                            AutomationProperties.AutomationId="HelpButton" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="2*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ScanStatus}" TextWrapping="Wrap" ToolTip="{Binding SkipHint}" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="{Binding ElevationNote}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SourceHint}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding CurrentPath}"
                               ToolTip="{Binding CurrentPathFull}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding RestoreProgress}" TextWrapping="Wrap"
                               AutomationProperties.Name="Restore progress" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" MaxHeight="140"
                             ItemsSource="{Binding Sources}"
                             DisplayMemberPath="DisplayLabel"
                             SelectedValuePath="Path"
                             SelectedValue="{Binding SelectedSourcePath}"
                             AutomationProperties.Name="Windows.old sources" />
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="Browse…" Command="{Binding BrowseSourceCommand}"
                                AutomationProperties.Name="Browse for Windows.old"
                                AutomationProperties.AutomationId="BrowseSourceButton" />
                    </StackPanel>

                    <DockPanel Grid.Row="1" Margin="0,8,0,8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Cards" Command="{Binding ShowCardsCommand}" Margin="0,0,8,0" />
                            <Button Content="Files" Command="{Binding ShowFilesCommand}" Margin="0,0,8,0" />
                            <Button Content="Inspect" Command="{Binding ShowInspectCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Inspect pane">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompactLayout}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ComboBox Width="120"
                                      ItemsSource="{Binding FilesViewModes}"
                                      SelectedItem="{Binding FilesViewMode}" />
                            <ComboBox Width="72" Margin="8,0,0,0"
                                      ItemsSource="{Binding RecentDayChoices}"
                                      SelectedItem="{Binding RecentDays}"
                                      AutomationProperties.Name="Recent days">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecentView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Width="180" Margin="8,0,0,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search files"
                                     AutomationProperties.AutomationId="SearchBox" />
                            <Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"
                                    AutomationProperties.Name="Search now" />
                            <CheckBox Content="Hash files smaller than 64 MB during scan"
                                      IsChecked="{Binding HashDuringScan}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Cards}"
                                 SelectedItem="{Binding SelectedCard}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DecidePane}" Value="Cards" />
                                                <Condition Binding="{Binding CompactInspect}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Summary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Absent">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Facts}" Foreground="Gray">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Absent">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DecisionLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Absent">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Absent">
                                                        <Setter Property="Margin" Value="0,0,0,2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListView x:Name="FilesList"
                              ItemsSource="{Binding TreeRows}"
                              SelectedItem="{Binding SelectedNode, Mode=OneWay}"
                              SelectionMode="Extended"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              TextSearch.TextPath="Name"
                              SelectionChanged="OnFilesSelectionChanged"
                              AutomationProperties.Name="Recoverable files">
                            <ListView.Style>
                                <Style TargetType="ListView">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DecidePane}" Value="Files" />
                                                <Condition Binding="{Binding CompactInspect}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Style>
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Inspect" Command="{Binding InspectCommand}" />
                                <MenuItem Header="Reveal in tree" Command="{Binding RevealInTreeCommand}" />
                                <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                <MenuItem Header="Restore" Command="{Binding RestoreCommand}" />
                                <MenuItem Header="Leave Behind" Command="{Binding LeaveBehindCommand}" />
                                <MenuItem Header="Undecided" Command="{Binding UndecidedCommand}" />
                                <MenuItem Header="Undo last decision" Command="{Binding UndoDecisionCommand}" />
                                <MenuItem Header="Restore except regeneratable" Command="{Binding RestoreExceptRegeneratableCommand}" />
                                <MenuItem Header="Restore only newer files" Command="{Binding RestoreNewerCommand}" />
                                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="220" />
                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="90" />
                                <GridViewColumn Header="Files" DisplayMemberBinding="{Binding FilesLabel}" Width="70" />
                                <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding ModifiedLabel}" Width="110" />
                                <GridViewColumn Header="Decision" DisplayMemberBinding="{Binding DecisionLabel}" Width="140" />
                                <GridViewColumn Header="Problem" DisplayMemberBinding="{Binding Problem}" Width="120" />
                                <GridViewColumn Header="Badges" DisplayMemberBinding="{Binding BadgeText}" Width="160" />
                            </GridView>
                        </ListView.View>
                        </ListView>
                        <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding DetailText, Mode=OneWay}"
                                 AutomationProperties.Name="Inspect details">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CompactInspect}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="{Binding ScanButtonLabel}" Command="{Binding ScanCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Start scan" AutomationProperties.AutomationId="ScanButton" />
                        <Button Content="Pause" Command="{Binding PauseScanCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Pause scan" />
                        <Button Content="Cancel" Command="{Binding CancelScanCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Cancel scan" />
                        <Button Content="Restore (R)" Command="{Binding RestoreCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Mark restore" />
                        <Button Content="Leave Behind (L)" Command="{Binding LeaveBehindCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Mark leave behind" />
                        <Button Content="Undecided (U)" Command="{Binding UndecidedCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Mark undecided" />
                        <Button Content="Undo (Ctrl+Z)" Command="{Binding UndoDecisionCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Undo last decision"
                                AutomationProperties.AutomationId="UndoDecisionButton" />
                        <Button Content="Open Folder (O)" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Open folder" />
                        <Button Content="Preview plan" Command="{Binding PreparePreviewCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Preview plan"
                                AutomationProperties.AutomationId="PreviewPlanButton" />
                        <ComboBox Width="160" Margin="0,0,8,0"
                                  ItemsSource="{Binding ConflictPolicies}"
                                  SelectedItem="{Binding SelectedConflictPolicy}"
                                  AutomationProperties.Name="Conflict policy" />
                        <Button Content="Run restore" Command="{Binding ExecuteRestoreCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Run restore" />
                        <Button Content="Cancel restore" Command="{Binding CancelRestoreCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Cancel restore"
                                AutomationProperties.AutomationId="CancelRestoreButton" />
                        <Button Content="Pause restore" Command="{Binding PauseRestoreCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Pause restore"
                                AutomationProperties.AutomationId="PauseRestoreButton" />
                        <Button Content="Verify" Command="{Binding ExecuteVerifyCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Run verify" />
                        <Button Content="Expand" Command="{Binding ExpandCommand}" CommandParameter="{Binding SelectedNode}"
                                AutomationProperties.Name="Expand folder" />
                        <Button Content="Show more" Command="{Binding ShowMoreCommand}" Margin="8,0,0,0"
                                AutomationProperties.Name="Show more children"
                                Visibility="{Binding TreeTruncated, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button Content="Reveal in tree" Command="{Binding RevealInTreeCommand}" Margin="8,0,0,0"
                                AutomationProperties.Name="Reveal in tree" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PagingStatus}" />
                    </StackPanel>
                    <DockPanel Grid.Row="3">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Preview">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="Conflicts: existing destination files. Keep both is the default. Overwrite needs a per-file tick and the confirmation button." />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock VerticalAlignment="Center" Text="Destination folder:" Margin="0,0,8,0" />
                            <TextBox MinWidth="280"
                                     Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Restore destination folder" />
                            <Button Margin="8,0,0,0" Content="Change…"
                                    Command="{Binding BrowseDestinationCommand}"
                                    AutomationProperties.Name="Change destination folder" />
                            <CheckBox Margin="16,0,0,0" VerticalAlignment="Center"
                                      Content="Merge into the current user profile folders"
                                      IsChecked="{Binding MergeIntoProfile}"
                                      AutomationProperties.Name="Merge into existing folders" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{Binding PreviewSummaryText}"
                                   AutomationProperties.Name="Restore plan summary" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Re-check" Command="{Binding PreparePreviewCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Re-check restore plan"
                                    AutomationProperties.AutomationId="RecheckPreviewButton" />
                            <Button Content="Review undecided" Command="{Binding ReviewUndecidedCommand}"
                                    AutomationProperties.Name="Review undecided items" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                Content="{Binding OverwriteButtonLabel}"
                                Command="{Binding ApproveOverwritesCommand}" />
                        <ListBox MaxHeight="120" ItemsSource="{Binding Conflicts}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Approved, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Restore">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="{Binding RestoreProgress}"
                                   AutomationProperties.Name="Restore progress" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0"
                                   Visibility="{Binding HasRestoreWarnings, Converter={StaticResource VisibleWhenTrue}}">
                            <Button DockPanel.Dock="Right" Content="{Binding RestoreWarningsToggleLabel}"
                                    Command="{Binding ToggleRestoreWarningsCommand}" Margin="8,0,0,0"
                                    AutomationProperties.Name="Show restore warnings"
                                    AutomationProperties.AutomationId="ShowRestoreWarningsButton" />
                            <TextBlock Text="{Binding RestoreWarningSummary}" VerticalAlignment="Center"
                                       AutomationProperties.Name="Restore warnings" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{Binding RestoreWarningDetail}"
                                   AutomationProperties.Name="Restore warning details" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Pause — keeps what is already copied"
                                    Command="{Binding PauseRestoreCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Pause restore" />
                            <Button Content="Cancel — keeps what is already copied"
                                    Command="{Binding CancelRestoreCommand}"
                                    AutomationProperties.Name="Cancel restore" />
                        </StackPanel>
                        <ListBox MaxHeight="140" ItemsSource="{Binding RestoreJobs}"
                                 DisplayMemberPath="Display"
                                 AutomationProperties.Name="Restore jobs"
                                 AutomationProperties.AutomationId="RestoreJobsList" />
                    </DockPanel>
                    <DockPanel Grid.Row="5" Margin="0,8,0,0">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Verify">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="Re-run creates a new verify report. Failed items block purge until they pass or you type a reason and acknowledge." />
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{Binding VerifyFailureText}"
                                   AutomationProperties.Name="Verify failures" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Re-run" Command="{Binding ExecuteVerifyCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Re-run verify"
                                    AutomationProperties.AutomationId="RerunVerifyButton" />
                            <TextBox MinWidth="280"
                                     Text="{Binding VerifyAckReason, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Verify failure acknowledgement reason"
                                     AutomationProperties.AutomationId="VerifyAckReasonBox" />
                            <Button Margin="8,0,0,0" Content="Acknowledge failures"
                                    Command="{Binding AcknowledgeVerifyCommand}"
                                    AutomationProperties.Name="Acknowledge verify failures"
                                    AutomationProperties.AutomationId="AcknowledgeVerifyButton" />
                            <Button Margin="8,0,0,0" Content="Go to Purge"
                                    Command="{Binding GoToPurgeCommand}"
                                    AutomationProperties.Name="Go to purge"
                                    AutomationProperties.AutomationId="GoToPurgeButton" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="6" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="Purge">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding PurgeSummaryText}"
                                   AutomationProperties.Name="Purge checklist" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Purge deletes Windows.old after a successful verify. Type the folder name. Leave Behind never deletes; only this step does." />
                        <CheckBox Margin="0,8,0,0" Content="I have checked my restored files" IsChecked="{Binding FilesChecked}" />
                        <CheckBox Content="I acknowledge remaining Undecided items" IsChecked="{Binding UndecidedAcknowledged}" />
                        <Button Margin="0,4,0,0" Content="Review undecided" Command="{Binding ReviewUndecidedCommand}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Review undecided items before purge" />
                        <CheckBox Content="This is a custom source root (not named Windows.old)" IsChecked="{Binding CustomRootConfirmed}" />
                        <CheckBox Content="Prefer Windows Disk Cleanup (Previous Installations)" IsChecked="{Binding PreferCleanupHandler}" />
                        <TextBox Margin="0,8,0,0" Text="{Binding PurgeTypedFolderName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Type the Windows.old folder name to confirm purge" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Purge source" Command="{Binding ExecutePurgeCommand}" Margin="0,0,8,0" />
                            <Button Content="Create support bundle" Command="{Binding CreateSupportBundleCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecipeCardSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Planned destination (top-level folders; children follow)" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Change…"
                                    Command="{Binding BrowseDestinationCommand}"
                                    IsEnabled="{Binding CanEditDestination}"
                                    AutomationProperties.Name="Change planned destination" />
                            <TextBox Margin="0,0,8,0"
                                     IsEnabled="{Binding CanEditDestination}"
                                     Text="{Binding PlannedDestinationPath, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="Planned destination path" />
                        </DockPanel>
                    </StackPanel>
                    <TextBox IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding DetailText, Mode=OneWay}" />
                </DockPanel>
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecipeCardSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <controls:SmartCard DataContext="{Binding SelectedRecipeCard}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding RecipeComponents}"
                                      IsEnabled="{Binding CanMutateSession}"
                                      AutomationProperties.Name="Recipe components">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,4,0,0"
                                              Content="{Binding Display}"
                                              IsChecked="{Binding Restore, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChoose}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    IsEnabled="{Binding CanMutateSession}">
                            <Button Content="Restore" Command="{Binding RestoreCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Restore this app card" />
                            <Button Content="Leave Behind" Command="{Binding LeaveBehindCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Leave this app card behind" />
                            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}"
                                    AutomationProperties.Name="Open this app folder"
                                    AutomationProperties.AutomationId="RecipeOpenFolderButton" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                Panel.ZIndex="1"
                Visibility="{Binding HelpVisible, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel Margin="24">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Close help" Command="{Binding CloseHelpCommand}"
                            AutomationProperties.Name="Close help"
                            AutomationProperties.AutomationId="CloseHelpButton" />
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Help (local pages, no network)" />
                </DockPanel>
                <ListBox DockPanel.Dock="Left" Width="280" Margin="0,0,12,0"
                         ItemsSource="{Binding HelpTopics}"
                         DisplayMemberPath="Title"
                         SelectedItem="{Binding SelectedHelpTopic}"
                         AutomationProperties.Name="Help topics" />
                <TextBox IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding HelpText, Mode=OneWay}"
                         AutomationProperties.Name="Help page" />
            </DockPanel>
        </Border>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                Panel.ZIndex="1"
                Visibility="{Binding LogVisible, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel Margin="24">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Close log" Command="{Binding CloseLogCommand}"
                            AutomationProperties.Name="Close log"
                            AutomationProperties.AutomationId="CloseLogButton" />
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Session log (redacted, no secrets)" />
                </DockPanel>
                <TextBox IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding LogText, Mode=OneWay}"
                         AutomationProperties.Name="Session log"
                         AutomationProperties.AutomationId="SessionLogView" />
            </DockPanel>
        </Border>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                Panel.ZIndex="2"
                Visibility="{Binding FirstRunVisible, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Margin="48" MaxWidth="640" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="WinOld Recovery" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding FirstRunBody}"
                           AutomationProperties.Name="First run explanation" />
                <Button Margin="0,24,0,0" HorizontalAlignment="Left" Content="Continue"
                        Command="{Binding DismissFirstRunCommand}"
                        AutomationProperties.Name="Dismiss first run"
                        AutomationProperties.AutomationId="DismissFirstRunButton" />
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                Panel.ZIndex="3"
                Visibility="{Binding InterruptedRestoreVisible, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Margin="48" MaxWidth="640" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="Resume interrupted restore?" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding InterruptedRestoreText}"
                           AutomationProperties.Name="Interrupted restore explanation" />
                <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                    <Button Content="Resume"
                            Command="{Binding ResumeInterruptedCommand}"
                            AutomationProperties.Name="Resume interrupted restore"
                            AutomationProperties.AutomationId="ResumeInterruptedButton" />
                    <Button Margin="12,0,0,0" Content="Not now"
                            Command="{Binding DismissInterruptedCommand}"
                            AutomationProperties.Name="Dismiss interrupted restore"
                            AutomationProperties.AutomationId="DismissInterruptedButton" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                Panel.ZIndex="4"
                Visibility="{Binding DiskFullVisible, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Margin="48" MaxWidth="640" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="Destination volume is full" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding DiskFullText}"
                           AutomationProperties.Name="Disk full explanation" />
                <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                    <Button Content="Resume"
                            Command="{Binding ResumeDiskFullCommand}"
                            AutomationProperties.Name="Resume restore after freeing space"
                            AutomationProperties.AutomationId="ResumeDiskFullButton" />
                    <Button Margin="12,0,0,0" Content="Cancel"
                            Command="{Binding CancelDiskFullCommand}"
                            AutomationProperties.Name="Cancel paused restore"
                            AutomationProperties.AutomationId="CancelDiskFullButton" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
