{
  "rules": [
    {
      "id": "private-keys",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Private key or certificate material. Contents are never displayed.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "nameGlobs": ["*.pem", "*.key", "*.ppk", "*.pfx", "*.p12", "id_rsa", "id_ed25519", "id_ecdsa", "key.pem"]
    },
    {
      "id": "cert-with-key",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Certificate next to a key file.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "nameGlobs": ["*.crt", "*.cer"],
      "siblingGlobs": ["*.key", "*.pem"]
    },
    {
      "id": "env-secrets",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Contains credentials; prefer re-issuing them.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "nameGlobs": [".env", ".env.*", "*.secret", "secrets.json", ".netrc", ".npmrc", ".pypirc", ".yarnrc.yml", ".git-credentials"]
    },
    {
      "id": "cloud-cli",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Cloud CLI tokens may have expired; re-login is safer.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "pathContains": ["\\.aws\\", "\\.azure\\", "\\.kube\\config", "\\.docker\\config.json", "\\gcloud\\", "\\.terraform.d\\"]
    },
    {
      "id": "gnupg-home",
      "kind": "Sensitive",
      "badge": "GPG",
      "why": "OpenPGP keyring. Restore with gpg-agent stopped.",
      "sensitive": true,
      "suggestedDefault": "Restore",
      "directoryNames": ["gnupg", ".gnupg"]
    },
    {
      "id": "browser-secrets",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Browser passwords, cookies, or Firefox key material. Contents are never displayed.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "nameGlobs": ["Login Data", "Login Data For Account", "Cookies", "cookies.sqlite", "key4.db", "logins.json"]
    },
    {
      "id": "ntuser-hive",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Old user hive. Parsed offline; contents are not shown.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "nameGlobs": ["NTUSER.DAT", "ntuser.dat.LOG1", "ntuser.dat.LOG2", "NTUSER.DAT.LOG1", "NTUSER.DAT.LOG2"]
    },
    {
      "id": "dpapi-protect",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "DPAPI Protect folder. Machine-bound; copying it does not unlock secrets.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "directoryNames": ["Protect"],
      "pathContains": ["\\Microsoft\\Protect"]
    },
    {
      "id": "credential-vault",
      "kind": "Sensitive",
      "badge": "Sensitive",
      "why": "Windows Credential Manager vault files.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "directoryNames": ["Credentials"],
      "pathContains": ["\\Microsoft\\Credentials"]
    }
  ]
}
