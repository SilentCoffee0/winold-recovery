{
  "rules": [
    {
      "id": "keepass-db",
      "kind": "HighValue",
      "badge": "KeePass",
      "why": "Your password vault. Needs your master password and any key file.",
      "sensitive": true,
      "suggestedDefault": "Restore",
      "nameGlobs": ["*.kdbx", "*.kdb", "*.keyx"]
    },
    {
      "id": "outlook-pst",
      "kind": "HighValue",
      "badge": "Outlook",
      "why": "Open PST in Outlook: File → Open & Export → Open Outlook Data File.",
      "sensitive": true,
      "suggestedDefault": "Restore",
      "nameGlobs": ["*.pst"]
    },
    {
      "id": "outlook-ost",
      "kind": "HighValue",
      "badge": "Outlook",
      "why": "OST files are regenerated from the mail server.",
      "sensitive": true,
      "suggestedDefault": "Undecided",
      "nameGlobs": ["*.ost"]
    },
    {
      "id": "obsidian-vault",
      "kind": "HighValue",
      "badge": "Obsidian",
      "why": "Obsidian vault folder.",
      "suggestedDefault": "Restore",
      "directoryNames": [".obsidian"]
    },
    {
      "id": "vscode-settings",
      "kind": "HighValue",
      "badge": "VS Code",
      "why": "Editor settings and keybindings.",
      "suggestedDefault": "Restore",
      "pathGlobs": ["**\\Code\\User\\settings.json", "**\\Code\\User\\keybindings.json"]
    },
    {
      "id": "windows-terminal",
      "kind": "HighValue",
      "badge": "Windows Terminal",
      "why": "Terminal settings.",
      "suggestedDefault": "Restore",
      "pathGlobs": ["**\\Microsoft.WindowsTerminal_*\\LocalState\\settings.json"]
    },
    {
      "id": "vm-disks-vhdx",
      "kind": "HighValue",
      "badge": "VM disk",
      "why": "Copy only; re-register the disk in the hypervisor yourself.",
      "suggestedDefault": "Undecided",
      "nameGlobs": ["*.vhdx"],
      "headerHex": "7668647866696C65"
    },
    {
      "id": "vm-disks",
      "kind": "HighValue",
      "badge": "VM disk",
      "why": "Copy only; re-register the disk in the hypervisor yourself.",
      "suggestedDefault": "Undecided",
      "nameGlobs": ["*.vhd", "*.vmdk", "*.vdi", "*.qcow2", "*.ova", "*.vbox", "*.vmx"]
    },
    {
      "id": "databases",
      "kind": "HighValue",
      "badge": "Database",
      "why": "Application or personal database file.",
      "suggestedDefault": "Undecided",
      "nameGlobs": ["*.sqlite", "*.sqlite3", "*.db", "*.mdb", "*.accdb", "*.fdb"],
      "minSize": 1048576
    },
    {
      "id": "server-data-dir",
      "kind": "HighValue",
      "badge": "Database",
      "why": "Restore only with the same server version, server stopped.",
      "suggestedDefault": "Undecided",
      "nameGlobs": ["PG_VERSION", "ibdata1"]
    },
    {
      "id": "shell-dotfiles",
      "kind": "HighValue",
      "badge": "Dotfile",
      "why": "Shell and editor configuration.",
      "suggestedDefault": "Restore",
      "nameGlobs": [".bashrc", ".zshrc", ".profile", ".vimrc", ".editorconfig", ".wslconfig", ".condarc", ".gitignore_global", ".ideavimrc"]
    },
    {
      "id": "powershell-profiles",
      "kind": "HighValue",
      "badge": "PowerShell",
      "why": "PowerShell profile scripts. They restore with Documents.",
      "suggestedDefault": "Restore",
      "pathGlobs": [
        "**\\Documents\\PowerShell\\*.ps1",
        "**\\Documents\\WindowsPowerShell\\*.ps1",
        "**\\Documents\\PowerShell\\Modules",
        "**\\Documents\\WindowsPowerShell\\Modules"
      ]
    },
    {
      "id": "zotero-calibre",
      "kind": "HighValue",
      "badge": "Library",
      "why": "Personal library with a catalog database.",
      "suggestedDefault": "Restore",
      "nameGlobs": ["zotero.sqlite", "metadata.db"]
    },
    {
      "id": "joplin-db",
      "kind": "HighValue",
      "badge": "Joplin",
      "why": "Joplin notes database.",
      "suggestedDefault": "Restore",
      "pathGlobs": ["**\\Joplin\\database.sqlite"]
    },
    {
      "id": "logseq-graph",
      "kind": "HighValue",
      "badge": "Logseq",
      "why": "Logseq graph configuration.",
      "suggestedDefault": "Restore",
      "pathGlobs": ["**\\logseq\\config.edn"]
    },
    {
      "id": "dev-tool-config",
      "kind": "HighValue",
      "badge": "Dev config",
      "why": "Package-manager or compiler settings. Tokens may be present.",
      "suggestedDefault": "Restore",
      "pathGlobs": [
        "**\\.nuget\\NuGet.Config",
        "**\\.m2\\settings.xml",
        "**\\.gradle\\gradle.properties",
        "**\\.cargo\\config.toml"
      ]
    }
  ]
}
